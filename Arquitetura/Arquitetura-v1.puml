' Arquitetura-v1.puml
' Versão 1 do diagrama C4 (Containers) para Outbound Notification Service
' Assumptions: o `Digital Assistant Engine` e os plugins de canal são marcados como <<external>>.
' Ajuste conforme necessidade antes de renderizar.

@startuml Arquitetura-v1
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!include C4P/C4_Context.puml
!include C4P/C4_Container.puml

Person(campaigns, "Time de Campanhas", "Equipe que faz upload de arquivos de mailing")
Person(customer, "Cliente", "Usuário final que recebe mensagens")

System_Boundary(s1, "Outbound Notification Service") {
  Container(mi, "Mailing Ingestion Service", "Recebe upload de mailing, persiste metadados e gera URL", "API")
  Container(mdb, "Mailing DB", "Armazena metadados do mailing", "Relational DB")
  Container(objStorage, "Object Storage", "Armazena arquivos de mailing e fornece URL", "Object Storage <<external>>")

  Container(mp, "Mailing Processing Service", "Baixa o arquivo, lê linhas e enfileira itens", "Worker")
  Container(processLineQ, "ProcessLine", "Fila para itens agendados", "Queue")
  Container(sendMessageQ, "SendMessage", "Fila para envio imediato", "Queue")
  Container(scheduling, "Scheduling Service", "Move itens agendados para `SendMessage` no horário programado", "Worker")

  Container(dispatch, "Message Dispatch Service", "Consome `SendMessage` e registra status antes de chamar orquestração", "Worker")
  Container(orchestration, "Message Orchestration Service", "Resolve template/canal/endpoint e monta payload por canal", "Service")
  Container(config, "Configuration Service", "Fornece template, canal e endpoint", "Config DB")

  Container(messageProducerQ, "MessageProducer", "Fila com payload pronto para envio", "Queue")
  Container(producer, "Message Producer", "Consome payload e faz requisição HTTP ao Channel Orchestrator", "Worker")

  Container(channelOrch, "Channel Orchestrator", "Encaminha mensagens ao plugin do canal (desacoplado)", "Service")
  Container(channelPluginA, "Canal A Plugin", "Plugin que entrega mensagens para Canal A", "Plugin <<external>>")
  Container(channelPluginB, "Canal B Plugin", "Plugin que entrega mensagens para Canal B", "Plugin <<external>>")

  Container(digitalAssistant, "Digital Assistant Engine", "Processa respostas dos clientes e conduz diálogos", "Service <<external>>")
  Container(messageDb, "Message Status DB", "Registra status de entrega e histórico", "Relational DB")
}

Rel(campaigns, mi, "Upload de arquivo de mailing (identificadores + caso de uso)")
Rel(mi, mdb, "Persiste metadados do mailing")
Rel(mi, objStorage, "Salva arquivo e obtém URL")
Rel(mp, objStorage, "Baixa arquivo para processamento", "HTTP")

Rel(mp, sendMessageQ, "Enfileira itens imediatos")
Rel(mp, processLineQ, "Enfileira itens agendados")
Rel(scheduling, processLineQ, "Consome itens agendados")
Rel(scheduling, sendMessageQ, "Move itens para envio no horário programado")

Rel(dispatch, sendMessageQ, "Consome itens a enviar")
Rel(dispatch, orchestration, "Invoca orquestração e atualiza status", "gRPC/HTTP")
Rel(orchestration, config, "Consulta template, canal e endpoint")
Rel(orchestration, messageProducerQ, "Publica payload pronto")
Rel(orchestration, messageDb, "Registra status e histórico")

Rel(producer, messageProducerQ, "Consome payload")
Rel(producer, channelOrch, "Requisição HTTP com payload")
Rel(channelOrch, channelPluginA, "Aciona plugin de canal")
Rel(channelOrch, channelPluginB, "Aciona plugin de canal")
Rel(channelPluginA, customer, "Entrega mensagem")
Rel(channelPluginB, customer, "Entrega mensagem")

Rel(customer, digitalAssistant, "Interação bidirecional (quando aplicável)")
Rel(channelOrch, digitalAssistant, "Roteia respostas/recebe callbacks", "HTTP/webhook")

SHOW_LEGEND()
@enduml
